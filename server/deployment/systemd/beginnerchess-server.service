# BeginnerChess multiplayer server (systemd unit).
# Installed by deployment/scripts/install.sh to /etc/systemd/system/.
[Unit]
Description=BeginnerChess multiplayer server
Documentation=https://freedomnet.tech/chess/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=beginnerchess
Group=beginnerchess
WorkingDirectory=/opt/beginnerchess/server
ExecStart=/opt/beginnerchess/server/.venv/bin/python -m beginnerchess_server --config /etc/beginnerchess/server.toml
# SIGTERM: players are told, games are saved, connections close cleanly.
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=3

# Directories (created by systemd with the right owner)
RuntimeDirectory=beginnerchess
RuntimeDirectoryMode=0750
StateDirectory=beginnerchess
StateDirectoryMode=0750
ReadWritePaths=/var/backups/beginnerchess

# Hardening: an unprivileged user with as little access as possible
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
UMask=0027

# Resource limits
MemoryMax=768M
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
