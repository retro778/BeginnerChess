# Daily verified backup of the BeginnerChess database (see beginnerchess-backup.timer).
[Unit]
Description=BeginnerChess database backup
After=beginnerchess-server.service

[Service]
Type=oneshot
User=beginnerchess
Group=beginnerchess
ExecStart=/opt/beginnerchess/server/deployment/scripts/backup.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/backups/beginnerchess /run/beginnerchess
ReadOnlyPaths=/var/lib/beginnerchess
